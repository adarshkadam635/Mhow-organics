# Copy this file to .env and fill in real values. Never commit .env.

# Project Settings -> API in your Supabase dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Secret - server only. Never expose in store/supabase-config.js or any browser file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required: admin login is disabled until both are set. Use a long, unique password.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# Optional: webhook that sends the password-reset OTP by SMS. Without it,
# OTPs are only logged to the console (fine for local dev).
SMS_WEBHOOK_URL=

# Returns (optional). Days after delivery that returns are accepted; 0 = no limit.
RETURN_WINDOW_DAYS=7
# Order statuses that make items return-eligible (comma separated). Default: completed
RETURN_ORDER_STATUSES=completed
# Set to true to force admins to enter a note when approving a return.
RETURN_APPROVAL_NOTE_REQUIRED=false
